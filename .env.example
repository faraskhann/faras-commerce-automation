# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# MULTI-TENANT MODE (production): Postgres connection string (Supabase: use the
# Session pooler string). When set, clients are resolved from the `clients`
# table per request and the SHOPIFY_* vars below are ignored entirely.
# Run `npm run migrate` once, then `npm run add-client` per store.
DATABASE_URL=

# ---- DEV-ONLY single-store fallback (used ONLY when DATABASE_URL is unset) ----

# Your dev store domain, without https:// and without a trailing slash
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# RECOMMENDED — client credentials from your app in the Shopify Dev Dashboard.
# The backend mints its own access tokens at runtime and refreshes them
# automatically (tokens from this grant expire after ~24 hours).
# Required scopes on the app: read_orders, read_products
# (plus write_draft_orders / write_orders to run the test-order script)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# FALLBACK — a manually created access token. Only used when the client
# credentials above are not set. Expires ~24h after minting, so it is NOT
# suitable for production; fine for a quick local test.
SHOPIFY_ADMIN_TOKEN=

# Password for the /admin dashboard. REQUIRED for the dashboard to work at all
# (unset = admin routes disabled). In production (Railway env vars) set this to a
# long random value — e.g. `openssl rand -base64 24` — and never commit a real one.
ADMIN_PASSWORD=

# ---- Abandoned cart recovery (premium-tier clients only) ----
# Postmark: use a BROADCAST message stream — cart recovery is promotional.
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=
POSTMARK_MESSAGE_STREAM=broadcast
# Public origin used for unsubscribe links in emails, e.g. https://app.up.railway.app
PUBLIC_BASE_URL=
# Signs unsubscribe links so they cannot be forged. Use a long random value.
UNSUBSCRIBE_SECRET=
# Discount code offered in the third (72h) email.
ABANDONED_CART_DISCOUNT_CODE=
ABANDONED_CART_POLL_MINUTES=20

# Optional
PORT=3000

# Set to 1 when deployed behind a reverse proxy (Railway, Render, nginx) so the
# per-IP rate limit sees real client IPs instead of the proxy's.
TRUST_PROXY=

# Origins allowed to call /chat from a browser (the widget). Comma-separated, or "*".
# Unset, it defaults to https://<SHOPIFY_STORE_DOMAIN> plus localhost, which is what
# local development needs. Set it explicitly once the store has a custom domain:
# ALLOWED_ORIGIN=https://your-store.myshopify.com,https://www.yourbrand.com
ALLOWED_ORIGIN=
